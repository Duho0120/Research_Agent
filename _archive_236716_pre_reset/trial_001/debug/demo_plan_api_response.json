          "text": "{\n  \"plan_type\": \"initial_pipeline_plan\",\n  \"plan_title\": \"Baseline: Constant-Velocity (+80ms) using last two timesteps per id\",\n  \"objective\": \"Maximize R-Hit@1cm via a reproducible rule-based baseline; verify submission format (id,x,y,z) matches sample_submission.csv.\",\n  \"rationale\": [\n    \"Data profile only confirms sample_submission schema: id,x,y,z; target schema otherwise unknown.\",\n    \"Baseline guardrails prioritize simple, stable first trial; avoid complex models and high-cardinality features.\",\n    \"Prior trial memory for this workspace indicates a constant-velocity +80ms heuristic (t0 and t-40ms).\"\n  ],\n  \"pipeline_blueprint\": {\n    \"applied_data\": {\n      \"inputs\": [\n        \"data/train.* (if available): per-id time-ordered positions\",\n        \"data/test.*: per-id recent history to t0 and t-40ms\",\n        \"sample_submission.csv: canonical id list and output columns [id,x,y,z]\"\n      ],\n      \"output_schema\": [\"id\", \"x\", \"y\", \"z\"]\n    },\n    \"split\": {\n      \"method\": \"random_holdout_by_id\",\n      \"validation_size\": 0.1,\n      \"random_seed\": 42\n    },\n    \"preprocessing\": [\n      \"Group by id; sort by time column (prefer one of: ['t','time','timestamp_ms']).\",\n      \"Extract last two observations per id: P(t0) and P(t-40ms) for x,y,z.\",\n      \"If dt != 40ms, compute exact dt_ms between the last two rows; compute v = (P(t0)-P(prev)) / (dt_ms/1000).\",\n      \"Fallback: if only one observation available, predict P(t0) unchanged.\"\n    ],\n    \"model\": {\n      \"type\": \"RuleBasedConstantVelocity\",\n      \"fit_required\": false,\n      \"inference\": \"P_pred = P(t0) + v * 0.08 (seconds)\"\n    },\n    \"metric\": {\n      \"name\": \"R-Hit@1cm\",\n      \"definition\": \"mean( ||pred - true||_2 <= 0.01 ) over validation targets\"\n    },\n    \"prediction_procedure\": [\n      \"Load sample_submission.csv to get id order.\",\n      \"For each id, derive P(t0), P(prev), dt_ms from test context; compute v and P_pred.\",\n      \"Assemble outputs with columns [id,x,y,z] in sample_submission order.\"\n    ],\n    \"commands\": {\n      \"train\": \"{python} train_step.py\",\n      \"test\": \"{python} test_step.py\",\n      \"predict\": \"{python} predict_step.py\"\n    }\n  },\n  \"code_change_targets\": [\n    {\n      \"file\": \"predict_step.py\",\n      \"changes\": [\n        \"Read sample_submission.csv for id list and column order.\",\n        \"Load test context (auto-detect columns: ['id', 'x','y','z'] and time as one of ['t','time','timestamp_ms']).\",\n        \"Per id: sort by time; take last two rows; compute v and P_pred for x,y,z; fallback to last observed if <2 rows.\",\n        \"Write outputs/submission.csv with columns [id,x,y,z]; validate no NaNs/inf and row count matches sample_submission.\"\n      ]\n    },\n    {\n      \"file\": \"test_step.py\",\n      \"changes\": [\n        \"Load train data if present; split by id with validation_size=0.1, seed=42.\",\n        \"From validation histories, construct targets at t0+80ms and contexts up to t0.\",\n        \"Apply same constant-velocity predictor; compute R-Hit@1cm and basic counts.\",\n        \"Save outputs/metrics.json with {'R-Hit@1cm': float, 'n_ids': int}.\"\n      ]\n    },\n    {\n      \"file\": \"train_step.py\",\n      \"changes\": [\n        \"No model training; generate outputs/pipeline_summary.json with data columns detected, split params, and heuristic details.\",\n        \"Do not persist any model artifact (artifact_policy).\"\n      ]\n    }\n  ],\n  \"success_criteria\": [\n    \"outputs/submission.csv exactly matches sample_submission columns and id order; no NaN/inf; row count equals sample_submission.\",\n    \"outputs/metrics.json exists and includes R-Hit@1cm (if train data available).\",\n    \"outputs/pipeline_summary.json exists and records split params and heuristic.\",\n    \"Reproducible run with seed=42; no dependency on external services.\"\n  ],\n  \"implementation_notes\": [\n    \"Time detection: prefer 'timestamp_ms'; else 'time' (assumed ms); else 't'. Ensure numeric dtype.\",\n    \"Unit safety: dt_s = max((t0 - t_prev)/1000.0, 1e-6) to avoid divide-by-zero; clip absurd velocities if needed (optional cap at |v|<=100 m/s).\",\n    \"Vector ops with numpy/pandas; avoid saving any trained model artifact.\",\n    \"If test file already has explicit columns for last two snapshots (e.g., x0,y0,z0 and xm40,ym40,zm40), bypass grouping and compute directly.\",\n    \"Always drive prediction row order from sample_submission.csv.\"\n  ],\n  \"expected_outputs\": [\n    \"outputs/metrics.json\",\n    \"outputs/submission.csv\",\n    \"outputs/pipeline_summary.json\",\n    \"outputs/code_snapshot.txt\"\n  ]\n}"
        }
